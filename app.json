{
  "expo": {
    "name": "Notto",
    "slug": "notto",
    "version": "0.1.0",
    "scheme": "notto",
    "orientation": "default",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "edgeToEdgeEnabled": true
    },
    "plugins": [
      "expo-router",
      [
        "expo-sqlite",
        {
          "enableFTS": true
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Дозвольте Notto додавати вибрані фотографії до нотаток.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      "expo-font",
      "@react-native-community/datetimepicker"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
