{
  "name": "notto",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "typecheck": "tsc --noEmit",
    "test": "jest --runInBand",
    "doctor": "expo-doctor",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "postinstall": "node scripts/patch-react-native-screens.cjs && node scripts/patch-expo-file-system.cjs && node scripts/patch-expo-intent-launcher.cjs && node scripts/patch-react-native-calendars.cjs"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@react-native-community/datetimepicker": "8.4.4",
    "@react-native-google-signin/google-signin": "^16.1.5",
    "@react-navigation/native": "^7.1.8",
    "expo": "~54.0.33",
    "expo-constants": "~18.0.13",
    "expo-crypto": "~15.0.9",
    "expo-dev-client": "~6.0.21",
    "expo-document-picker": "~14.0.8",
    "expo-file-system": "19.0.24",
    "expo-font": "~14.0.12",
    "expo-image-picker": "~17.0.10",
    "expo-intent-launcher": "~13.0.8",
    "expo-linking": "~8.0.11",
    "expo-print": "~15.0.8",
    "expo-router": "~6.0.23",
    "expo-sharing": "~14.0.8",
    "expo-sqlite": "~16.0.10",
    "expo-status-bar": "~3.0.9",
    "fflate": "^0.8.3",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-hook-form": "^7.72.0",
    "react-native": "0.81.5",
    "react-native-calendars": "1.1314.0",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "4.16.0",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/node": "^24.0.0",
    "@types/react": "~19.1.0",
    "@types/react-test-renderer": "^19.3.0",
    "expo-doctor": "^1.17.11",
    "jest": "^29.7.0",
    "prettier": "^3.9.10",
    "react-test-renderer": "19.1.0",
    "ts-jest": "^29.4.0",
    "typescript": "~5.9.2"
  },
  "engines": {
    "node": ">=24 <25"
  },
  "expo": {
    "autolinking": {
      "android": {
        "buildFromSource": [
          "expo-file-system",
          "expo-intent-launcher"
        ]
      }
    }
  }
}
